From: TITAN-NT <titan@localhost>
Date: Wed, 19 Nov 2026 16:00:00 +0700
Subject: [PATCH] wineandroid: Trace the driver init failure points.

The driver returns FALSE from DllMain and explorer only sees
ERROR_DLL_INIT_FAILED; these logs say which step fails.
---
diff --git a/dlls/wineandroid.drv/dllmain.c b/dlls/wineandroid.drv/dllmain.c
--- a/dlls/wineandroid.drv/dllmain.c
+++ b/dlls/wineandroid.drv/dllmain.c
@@ -116,13 +116,21 @@
 BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, LPVOID reserved )
 {
     struct init_params params;
+    NTSTATUS status;
 
     if (reason != DLL_PROCESS_ATTACH) return TRUE;
 
     DisableThreadLibraryCalls( inst );
-    if (__wine_init_unix_call()) return FALSE;
+    if ((status = __wine_init_unix_call()))
+    {
+        ERR( "init unix call failed: %#x\n", (unsigned int)status );
+        return FALSE;
+    }
 
     params.register_window_callback = register_window_callback;
     params.start_device_callback = (UINT_PTR)android_start_device;
-    return !ANDROID_CALL( init, &params );
+    status = ANDROID_CALL( init, &params );
+    ERR( "unix init returned %#x, callbacks %p/%p\n", (unsigned int)status,
+         params.register_window_callback, (void *)params.start_device_callback );
+    return !status;
 }
diff --git a/dlls/wineandroid.drv/init.c b/dlls/wineandroid.drv/init.c
--- a/dlls/wineandroid.drv/init.c
+++ b/dlls/wineandroid.drv/init.c
@@ -526,13 +526,25 @@
     JavaVM *java_vm;
     void *ntdll;
 
-    if (!(ntdll = dlopen( "ntdll.so", RTLD_NOW ))) return STATUS_UNSUCCESSFUL;
+    if (!(ntdll = dlopen( "ntdll.so", RTLD_NOW )))
+    {
+        ERR( "failed to open ntdll.so: %s\n", dlerror() );
+        return STATUS_UNSUCCESSFUL;
+    }
 
     p_java_vm = dlsym( ntdll, "java_vm" );
     p_java_object = dlsym( ntdll, "java_object" );
     p_java_gdt_sel = dlsym( ntdll, "java_gdt_sel" );
+    ERR( "ntdll %p java_vm %p java_object %p java_gdt_sel %p\n", ntdll, p_java_vm,
+         p_java_object, p_java_gdt_sel );
+    if (!p_java_vm || !p_java_object)
+    {
+        ERR( "ntdll.so does not export the JNI globals\n" );
+        return STATUS_UNSUCCESSFUL;
+    }
 
     object = *p_java_object;
+    ERR( "java vm %p object %p\n", *p_java_vm, object );
 
     load_hardware_libs();
 
