+/* Classic futex operations. Android's app seccomp filter traps futex_waitv, so
+ * waits use a shared wake epoch and FUTEX_WAIT_BITSET instead. */
+#ifndef FUTEX_WAKE
+#define FUTEX_WAKE 1
+#endif
+#ifndef FUTEX_WAIT_BITSET
+#define FUTEX_WAIT_BITSET 9
+#endif
+#ifndef FUTEX_CLOCK_REALTIME
+#define FUTEX_CLOCK_REALTIME 256
+#endif
+#ifndef FUTEX_BITSET_MATCH_ANY
+#define FUTEX_BITSET_MATCH_ANY 0xffffffff
 #endif
 
-#define u64_to_ptr(x) (void *)(uintptr_t)(x)
+/* shm index 0 is never handed out to an object, so both sides use it as the wake
+ * epoch: signallers bump it and waiters sleep on it. */
+#define FSYNC_EPOCH_SHM_IDX 0
+
+#define FSYNC_SHM_NAME "fsync.shm"
 
