-    struct futex_waitv futexes[2];
-    int ret;
-
-    futex_vector_set( &futexes[0], addr, val );
+    int *epoch = epoch_word();
+    int ret, epoch_val;
 
     if (alertable)
     {
@@ -714,22 +746,20 @@
 
         if (__atomic_load_n( apc_futex, __ATOMIC_SEQ_CST ))
             return STATUS_USER_APC;
+    }
 
-        futex_vector_set( &futexes[1], apc_futex, 0 );
+    epoch_val = __atomic_load_n( epoch, __ATOMIC_SEQ_CST );
+    if (__atomic_load_n( addr, __ATOMIC_SEQ_CST ) != val)
+        return STATUS_PENDING;
 
-        ret = futex_wait_multiple( futexes, 2, end, clock_id );
+    ret = futex_wait_epoch( epoch, epoch_val, end, clock_id );
 
-        if (__atomic_load_n( apc_futex, __ATOMIC_SEQ_CST ))
-            return STATUS_USER_APC;
-    }
-    else
-    {
-        ret = futex_wait_multiple( futexes, 1, end, clock_id );
-    }
+    if (alertable && __atomic_load_n( ntdll_get_thread_data()->fsync_apc_futex, __ATOMIC_SEQ_CST ))
+        return STATUS_USER_APC;
 
     if (!ret)
         return 0;
-    else if (ret < 0 && errno == ETIMEDOUT)
+    else if (errno == ETIMEDOUT)
         return STATUS_TIMEOUT;
     else
         return STATUS_PENDING;
@@ -751,15 +781,13 @@
     int current_tid = 0;
 #define CURRENT_TID (current_tid ? current_tid : (current_tid = GetCurrentThreadId()))
 
-    struct futex_waitv futexes[MAXIMUM_WAIT_OBJECTS + 1];
     struct fsync objs[MAXIMUM_WAIT_OBJECTS];
     int prev_pids[MAXIMUM_WAIT_OBJECTS];
     int has_fsync = 0, has_server = 0;
     clockid_t clock_id = 0;
     struct timespec64 end;
-    int dummy_futex = 0;
+    int epoch_val;
     BOOL waited = FALSE;
-    DWORD waitcount;
     int i, ret;
 
     /* Grab the APC futex if we don't already have it. */
@@ -821,6 +849,11 @@
                     goto userapc;
             }
 
+            /* Read the epoch before scanning the objects, see wake_epoch().
+             * A server object has no local word to watch; the epoch still wakes
+             * us when the server signals one through fsync_set_event(). */
+            epoch_val = __atomic_load_n( epoch_word(), __ATOMIC_SEQ_CST );
+
             for (i = 0; i < count; i++)
             {
                 struct fsync *obj = &objs[i];
@@ -848,7 +881,6 @@
