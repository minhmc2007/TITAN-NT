diff --git a/server/fsync.c b/server/fsync.c
--- a/server/fsync.c
+++ b/server/fsync.c
@@ -51,14 +51,33 @@
 #ifndef __NR_futex_waitv
 #define __NR_futex_waitv 449
 #endif
+#ifndef FUTEX_WAKE
+#define FUTEX_WAKE 1
+#endif
+
+/* shm index 0 is never handed out to an object, so both sides use it as the wake
+ * epoch: signallers bump it and waiters sleep on it. */
+#define FSYNC_EPOCH_SHM_IDX 0
+
+#define FSYNC_SHM_NAME "fsync.shm"
 
 int do_fsync_cached = -1;
 
 int fsync_check_support(void)
 {
 #ifdef __linux__
+#ifdef __ANDROID__
+    /* Android's app seccomp filter traps futex_waitv, so waits use the shared
+     * epoch with the classic futex call. Enable fsync by default and keep
+     * WINEFSYNC=0 as the escape hatch. */
+    syscall( __NR_futex, NULL, FUTEX_WAKE, 0, NULL, 0, 0 );
+    if (errno == ENOSYS || errno == EPERM) return 0;
+    if (getenv( "WINEFSYNC" ) && !atoi( getenv( "WINEFSYNC" ) )) return 0;
+    return 1;
+#else
     syscall( __NR_futex_waitv, 0, 0, 0, 0, 0 );
     return getenv( "WINEFSYNC" ) && atoi(getenv( "WINEFSYNC" )) && errno != ENOSYS && errno != EPERM;
+#endif
 #else
     return 0;
 #endif
@@ -81,8 +100,13 @@
 static void shm_cleanup(void)
 {
     close( shm_fd );
+#ifdef __ANDROID__
+    if (unlinkat( config_dir_fd, shm_name, 0 ) == -1)
+        perror( "unlinkat" );
+#else
     if (shm_unlink( shm_name ) == -1)
         perror( "shm_unlink" );
+#endif
 }
 
 void fsync_init(void)
@@ -92,6 +116,18 @@
     if (fstat( config_dir_fd, &st ) == -1)
         fatal_error( "cannot stat config dir\n" );
 
+#ifdef __ANDROID__
+    /* Bionic has no POSIX shared memory. A file in the config directory is the
+     * same shared mapping, and both sides already agree on that directory. */
+    strcpy( shm_name, FSYNC_SHM_NAME );
+
+    if (!unlinkat( config_dir_fd, shm_name, 0 ))
+        fprintf( stderr, "fsync: warning: a previous shm file %s was not properly removed\n", shm_name );
+
+    shm_fd = openat( config_dir_fd, shm_name, O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0644 );
+    if (shm_fd == -1)
+        perror( "openat" );
+#else
     if (st.st_ino != (unsigned long)st.st_ino)
         sprintf( shm_name, "/wine-%lx%08lx-fsync", (unsigned long)((unsigned long long)st.st_ino >> 32), (unsigned long)st.st_ino );
     else
@@ -103,6 +139,7 @@
     shm_fd = shm_open( shm_name, O_RDWR | O_CREAT | O_EXCL, 0644 );
     if (shm_fd == -1)
         perror( "shm_open" );
+#endif
 
     shm_addrs = calloc( 128, sizeof(shm_addrs[0]) );
     shm_addrs_size = 128;
@@ -310,7 +347,15 @@
 
 static inline int futex_wake( int *addr, int val )
 {
-    return syscall( __NR_futex, addr, 1, val, NULL, 0, 0 );
+    return syscall( __NR_futex, addr, FUTEX_WAKE, val, NULL, 0, 0 );
+}
+
+static void wake_epoch(void)
+{
+    int *epoch = get_shm( FSYNC_EPOCH_SHM_IDX );
+
+    __atomic_add_fetch( epoch, 1, __ATOMIC_SEQ_CST );
+    futex_wake( epoch, INT_MAX );
 }
 
 /* shm layout for events or event-like objects. */
@@ -327,7 +372,7 @@
     struct fsync_event *event = get_shm( shm_idx );
 
     if (!__atomic_exchange_n( &event->signaled, 1, __ATOMIC_SEQ_CST ))
-        futex_wake( &event->signaled, INT_MAX );
+        wake_epoch();
 }
 
 void fsync_reset_event( unsigned int shm_idx )
@@ -354,7 +399,7 @@
 
     mutex->tid = ~0;
     mutex->count = 0;
-    futex_wake( &mutex->tid, INT_MAX );
+    wake_epoch();
 }
 
