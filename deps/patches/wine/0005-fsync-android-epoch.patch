 {
@@ -121,14 +125,6 @@
     end->tv_nsec = (nt_end % TICKSPERSEC) * 100;
 }
 
-static inline void futex_vector_set( struct futex_waitv *waitv, int *addr, int val )
-{
-    waitv->uaddr = (uintptr_t) addr;
-    waitv->val = val;
-    waitv->flags = FUTEX_32;
-    waitv->__reserved = 0;
-}
-
