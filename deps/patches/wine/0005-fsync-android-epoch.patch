-#ifndef __NR_futex_waitv
-
-# define __NR_futex_waitv 449
-# define FUTEX_32 2
-struct futex_waitv {
-    uint64_t   val;
-    uint64_t   uaddr;
-    uint32_t   flags;
-    uint32_t __reserved;
-};
