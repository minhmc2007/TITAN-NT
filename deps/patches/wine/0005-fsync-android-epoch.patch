 {
     if (!fsync_simulate_sched_quantum) return;
@@ -138,18 +134,9 @@
     usleep(0);
 }
 
-static inline int futex_wait_multiple( const struct futex_waitv *futexes,
-        int count, const struct timespec64 *end, clockid_t clock_id )
-{
-   if (end)
-        return syscall( __NR_futex_waitv, futexes, count, 0, end, clock_id );
-   else
-        return syscall( __NR_futex_waitv, futexes, count, 0, NULL, 0 );
-}
-
 static inline int futex_wake( int *addr, int val )
 {
-    return syscall( __NR_futex, addr, 1, val, NULL, 0, 0 );
+    return syscall( __NR_futex, addr, FUTEX_WAKE, val, NULL, 0, 0 );
 }
 
 struct fsync
@@ -185,7 +172,9 @@
 };
 C_ASSERT(sizeof(struct mutex) == 16);
 
+#ifndef __ANDROID__
 static char shm_name[29];
+#endif
 static int shm_fd;
 static volatile void *shm_addrs[8192];
 
@@ -218,6 +207,38 @@
     return (char *)shm_addrs[entry] + offset;
 }
 
+static int *epoch_word(void)
+{
+    return get_shm( FSYNC_EPOCH_SHM_IDX );
+}
+
+/* A signaller stores the object first and bumps the epoch second, so a waiter
+ * that reads the epoch before scanning the objects either sees the object or
+ * has its futex wait rejected with EAGAIN. */
+static void wake_epoch(void)
+{
+    int *epoch = epoch_word();
+
+    __atomic_add_fetch( epoch, 1, __ATOMIC_SEQ_CST );
+    futex_wake( epoch, INT_MAX );
+}
+
+static inline int futex_wait_epoch( int *epoch, int val, const struct timespec64 *end,
+                                    clockid_t clock_id )
+{
+    struct timespec ts;
+    int op = FUTEX_WAIT_BITSET;
+
+    if (clock_id == CLOCK_REALTIME) op |= FUTEX_CLOCK_REALTIME;
+    if (end)
+    {
+        ts.tv_sec = end->tv_sec;
+        ts.tv_nsec = end->tv_nsec;
+        return syscall( __NR_futex, epoch, op, val, &ts, 0, FUTEX_BITSET_MATCH_ANY );
+    }
+    return syscall( __NR_futex, epoch, op, val, NULL, 0, FUTEX_BITSET_MATCH_ANY );
+}
+
 /* We'd like lookup to be fast. To that end, we use a static list indexed by handle.
  * This is copied and adapted from the fd cache code. */
 
@@ -452,10 +473,22 @@
 
