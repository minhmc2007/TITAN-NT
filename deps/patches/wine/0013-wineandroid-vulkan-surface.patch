From: TITAN-NT <titan@localhost>
Date: Tue, 17 Nov 2026 13:25:00 +0700
Subject: [PATCH] wineandroid: Create host Vulkan surfaces from the Android client window.

win32u hands the driver an HWND, while the host loader needs an ANativeWindow.
Wrap the registered client window so the loader owns Android WSI, and report
VK_TRUE for presentation support since every Android window can present.
---
diff --git a/dlls/wineandroid.drv/Makefile.in b/dlls/wineandroid.drv/Makefile.in
--- a/dlls/wineandroid.drv/Makefile.in
+++ b/dlls/wineandroid.drv/Makefile.in
@@ -10,6 +10,7 @@ SOURCES = \
 	init.c \
 	keyboard.c \
 	opengl.c \
+	vulkan.c \
 	window.c \
 	wine.svg
 
diff --git a/dlls/wineandroid.drv/android.h b/dlls/wineandroid.drv/android.h
--- a/dlls/wineandroid.drv/android.h
+++ b/dlls/wineandroid.drv/android.h
@@ -56,6 +56,13 @@ DECL_FUNCPTR( ANativeWindow_release );
 extern UINT ANDROID_OpenGLInit( UINT version, const struct opengl_funcs *opengl_funcs, const struct opengl_driver_funcs **driver_funcs );
 
 
+/**************************************************************************
+ * Vulkan driver
+ */
+
+extern UINT ANDROID_VulkanInit( UINT version, void *vulkan_handle, const struct vulkan_driver_funcs **driver_funcs );
+
+
 /**************************************************************************
  * Android pseudo-device
  */
diff --git a/dlls/wineandroid.drv/init.c b/dlls/wineandroid.drv/init.c
--- a/dlls/wineandroid.drv/init.c
+++ b/dlls/wineandroid.drv/init.c
@@ -319,6 +319,7 @@ static const struct user_driver_funcs android_drv_funcs =
     .pWindowPosChanging = ANDROID_WindowPosChanging,
     .pCreateWindowSurface = ANDROID_CreateWindowSurface,
     .pWindowPosChanged = ANDROID_WindowPosChanged,
+    .pVulkanInit = ANDROID_VulkanInit,
     .pOpenGLInit = ANDROID_OpenGLInit,
 };
 
diff --git a/dlls/wineandroid.drv/vulkan.c b/dlls/wineandroid.drv/vulkan.c
new file mode 100644
--- /dev/null
+++ b/dlls/wineandroid.drv/vulkan.c
@@ -0,0 +1,155 @@
